@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>

<div class="input-group mb-3">
    <form asp-action="FindUser" asp-controller="Admin" method="post">
        <input type="text" name="request" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="button-addon2">

        <button typeof="submit" class="btn btn-outline-secondary" type="submit" id="button-addon2">Done</button>
    </form>
</div>

@foreach(var user in Model)
{
	<div>@user.UserName @user.PhoneNumber @user.Email</div>
    <div class="card-footer bg-white border-0 d-flex justify-content-between gap-3 px-4 pb-4 mt-auto">
        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@user.Id"
           class="btn btn-outline-primary btn-custom flex-grow-1">
            Edit
        </a>
        <a asp-controller="Admin" asp-action="DeleteTotal" asp-route-id="@user.Id"
           class="btn btn-outline-danger btn-custom flex-grow-1"
           onclick="return confirm('Видалити цей обліковий запис?');">
            Delete
        </a>
    </div>

}