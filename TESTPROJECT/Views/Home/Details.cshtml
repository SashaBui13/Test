@{
    ViewData["Title"] = Model.Name;
    var categoryName = Model.Categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? "Каталог";
}
@model TESTPROJECT.Models.ViewModels.ProductViewModel

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 m-0">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none fw-semibold" style="color: var(--main-purple);">Головна</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Category" asp-action="InCategory" asp-route-id="@Model.CategoryId" class="text-decoration-none fw-semibold" style="color: var(--main-purple);">@categoryName</a>
            </li>
            <li class="breadcrumb-item active fw-semibold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm" style="border-radius: 20px;">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-5">
                <div class="col-lg-5">
                    <div class="bg-light rounded-4 d-flex align-items-center justify-content-center p-4 h-100" style="min-height: 450px; border: 1px solid #eee;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid drop-shadow" style="max-height: 400px; object-fit: contain;" />
                        }
                        else
                        {
                            <i class="fa-solid fa-box-open text-muted" style="font-size: 8rem; opacity: 0.5;"></i>
                        }
                    </div>
                </div>

                <div class="col-lg-7 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-success fw-bold fs-6">
                            <i class="fa-solid fa-check-circle me-1"></i> В наявності
                        </span>
                        <span class="text-muted small fw-semibold">Код товару: @Model.Id</span>
                    </div>

                    <h1 class="fw-bold mb-4" style="color: var(--deep-bg); font-size: 2.2rem; line-height: 1.3;">
                        @Model.Name
                    </h1>

                    <div class="p-4 mb-4 rounded-4" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                        <div class="row align-items-center">
                            <div class="col-sm-6 mb-3 mb-sm-0">
                                <span class="text-muted d-block mb-1 fw-semibold">Ціна</span>
                                <span class="fw-bold" style="font-size: 2.5rem; color: var(--main-purple);">
                                    @Model.Price ₴
                                </span>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex align-items-center quantity-box" style="width:140px;">

                                        <button class="btn btn-outline-secondary border-secondary-subtle bg-white fw-bold px-3 minus-btn" type="button">
                                            -
                                        </button>

                                        <input type="text"
                                        class="form-control text-center fw-bold border-secondary-subtle bg-white quantity-input"
                                        value="1" readonly>

                                        <button class="btn btn-outline-secondary border-secondary-subtle bg-white fw-bold px-3 plus-btn" type="button">
                                            +
                                        </button>

                                    </div>
                                    <a asp-controller ="Cart" asp-action="AddToCart" asp-route-productId="@Model.Id" button class="btn text-white fw-bold py-3 px-4 w-100 shadow-sm" style="background-color: var(--main-purple); border-radius: 12px; font-size: 1.1rem;">
                                        <i class="bi bi-cart"></i>Купити
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2 flex-grow-1">
                        <ul class="nav nav-tabs mb-4" id="productTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold px-4" style="color: var(--main-purple);" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab">Повний Опис</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold text-muted px-4" id="chars-tab" data-bs-toggle="tab" data-bs-target="#chars" type="button" role="tab">Характеристики</button>
                            </li>
                        </ul>

                        <div class="tab-content" id="productTabsContent">
                            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                                <p class="text-secondary" style="line-height: 1.8; font-size: 1.05rem;">
                                    @Model.LongDescription
                                </p>
                            </div>
                            <div class="tab-pane fade" id="chars" role="tabpanel">
                                <ul class="list-group list-group-flush border-top">
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <span class="text-muted">Категорія</span>
                                        <span class="fw-semibold">@categoryName</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 bg-transparent">
                                        <span class="text-muted">Короткий Опис</span>
                                        <span class="fw-semibold">@Model.Description</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-5" style="border-radius: 20px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
    <div class="card-header border-0 text-white p-4" style="background: linear-gradient(135deg, #6f42c1, #8b5cf6); border-radius: 20px 20px 0 0;">
        <h4 class="mb-0 fw-bold"><i class="fa-solid fa-comment-dots me-2"></i>Залишити відгук</h4>
    </div>

    <div class="card-body p-4 p-md-5">
        <form asp-controller="Comment" asp-action="AddComment" method="post">
            <input type="hidden" name="ProductId" value="@Model.Id" />

            @if (!User.Identity.IsAuthenticated)
            {
                <div class="form-floating mb-4">
                    <input type="text" name="UserName" class="form-control custom-input" id="userNameInput" placeholder="Ваше ім'я" required>
                    <label for="userNameInput" class="text-muted"><i class="fa-regular fa-user me-2"></i>Ваше ім'я</label>
                </div>
            }
            else
            {
                <input type="hidden" name="UserName" value="@User.Identity.Name" />

                <div class="d-flex align-items-center mb-4 p-3 rounded-3" style="background-color: #f8f9fa; border-left: 4px solid #8b5cf6;">
                    <div class="me-3" style="color: #6f42c1;">
                        <i class="fa-solid fa-circle-user fs-2"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1" style="font-size: 0.8rem;">Ви залишаєте відгук як:</small>
                        <span class="fw-bold fs-5 text-dark">@User.Identity.Name</span>
                    </div>
                </div>
            }

            <div class="form-floating mb-4">
                <textarea name="CommentText" class="form-control custom-input" id="exampleInput" placeholder="Опишіть покупку" required style="height: 120px; resize: none;"></textarea>
                <label for="exampleInput" class="text-muted"><i class="fa-regular fa-message me-2"></i>Поділіться враженнями про товар...</label>
            </div>

            <div class="text-end">
                <button type="submit" class="btn-submit-review">
                    <i class="fa-solid fa-paper-plane me-2"></i>Опублікувати
                </button>
            </div>
        </form>
    </div>
</div>


<div class="mt-5 mb-5">
    <h4 class="fw-bold mb-4" style="color: var(--deep-bg, #2c3e50);">
        <i class="fa-regular fa-comments me-2" style="color: #6f42c1;"></i>Відгуки покупців
    </h4>

    <div class="d-flex flex-column gap-3">
        @foreach (var comments in Model.Comments)
        {
            <div class="card shadow-sm border-0 comment-card" style="border-radius: 15px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">

                        <div class="flex-shrink-0 me-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                        style="width: 50px; height: 50px; background: linear-gradient(135deg, #6f42c1, #8b5cf6); color: white;">
                            <i class="fa-solid fa-user fs-5"></i>
                        </div>

                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="fw-bold mb-0 text-dark fs-5">@comments.UserName</h6>
                            </div>

                            <p class="mb-0 text-secondary mt-2" style="line-height: 1.6; font-size: 1.05rem;">
                                @comments.CommentText
                            </p>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Comment" asp-action="DeleteComment" asp-route-id="@comments.Id" asp-route-ProductId="@comments.ProductId">
                                <i class="bi bi-trash"></i>
                        </a>
                        }
                    </div>
                </div>
            </div>
        }

         @if (!Model.Comments.Any())
        {
            <div class="text-center p-5 rounded-3" style="background-color: rgba(111, 66, 193, 0.05); border: 2px dashed rgba(111, 66, 193, 0.2);">
                <i class="fa-regular fa-comment-dots fs-1 mb-3" style="color: #8b5cf6;"></i>
                <h5 class="fw-bold">Поки що немає відгуків</h5>
                <p class="mb-0">Будьте першим, хто поділиться своїми враженнями про цей товар!</p>
            </div>
        } 
        
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const plusButtons = document.querySelectorAll(".plus-btn");
            const minusButtons = document.querySelectorAll(".minus-btn");

            plusButtons.forEach(button => {
                button.addEventListener("click", function () {

                    let input = this.parentElement.querySelector(".quantity-input");
                    let value = parseInt(input.value);

                    input.value = value + 1;
                });
            });

            minusButtons.forEach(button => {
                button.addEventListener("click", function () {

                    let input = this.parentElement.querySelector(".quantity-input");
                    let value = parseInt(input.value);

                    if (value > 1) {
                        input.value = value - 1;
                    }
                });
            });

        });
    </script>
    <style>
        .comment-card {
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.6) !important;
        }

            .comment-card:hover {
                transform: translateX(5px); 
                box-shadow: 0 8px 20px rgba(111, 66, 193, 0.15) !important;
                border-color: rgba(139, 92, 246, 0.3) !important;
            }
        .custom-input {
            border-radius: 12px !important;
            border: 2px solid #e9ecef !important;
            transition: all 0.3s ease;
        }


            .custom-input:focus {
                border-color: #8b5cf6 !important;
                box-shadow: 0 0 0 0.25rem rgba(139, 92, 246, 0.15) !important;
            }


        .btn-submit-review {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #6f42c1, #8b5cf6);
            color: white !important;
            border: none;
            border-radius: 50px;
            padding: 12px 35px;
            font-size: 1.1rem;
            font-weight: bold;
            box-shadow: 0 6px 15px rgba(111, 66, 193, 0.3);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

            .btn-submit-review:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(111, 66, 193, 0.4);
            }

    </style>
}