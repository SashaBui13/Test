@model TESTPROJECT.Models.ViewModels.LocationViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-header text-white text-center" style="background: linear-gradient(135deg, #6f42c1, #8b5cf6); border-radius: 15px 15px 0 0;">
                    <h3 class="mb-0 fw-bold py-2">Редагувати локацію</h3>
                </div>
                <div class="card-body p-4 bg-white">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">

                        <input asp-for="LocationId" hidden />

                        <div class="row mb-4">
                            
                            <div class="col-md-8">
                                
                                <div class="form-floating mb-3">
                                    <input asp-for="LocationName" class="form-control" placeholder="Назва" required />
                                    <label asp-for="LocationName">Назва локації</label>
                                </div>
                            </div>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="LocationAdress" class="form-control" placeholder="Адреса" required />
                            <label asp-for="LocationAdress">Адреса локації</label>
                        </div>
                        <div class="form-floating mb-4">
                            <input asp-for="LocationMapsPath" class="form-control" placeholder="Посилання" required />
                            <label asp-for="LocationMapsPath">Посилання на Google Maps</label>
                        </div>

                        <div class="d-flex gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold w-50 py-2" style="border-radius: 10px;">Скасувати</a>
                            <button type="submit" class="btn text-white fw-bold w-50 py-2" style="background-color:#6f42c1; border-radius: 10px;">Оновити локацію</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>