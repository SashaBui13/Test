@model TESTPROJECT.Models.ViewModels.LocationViewModel

<div class="container py-5">
    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-body text-white text-center" style="background: linear-gradient(135deg, #6f42c1, #8b5cf6); border-radius: 15px;">
                    <i class="fa-solid fa-map-location-dot fs-1 mb-2"></i>
                    <h3 class="mb-0 fw-bold py-2">Наші локації</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var location in Model.Location)
        {
            @if (location.LocationIsDeleted == false)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 d-flex flex-column" style="border-radius: 15px; transition: transform 0.2s ease, box-shadow 0.2s ease;">

                        <a asp-controller="ProductToLocation" asp-action="Index" asp-route-locationId="@location.LocationId" class="text-decoration-none">
                            <div class="card-header text-white border-0" style="background: linear-gradient(135deg, #6f42c1, #8b5cf6); border-radius: 15px 15px 0 0; padding: 20px;">
                                <h4 class="card-title mb-0 fw-bold text-center">
                                    <i class="fa-solid fa-shop me-2"></i>@location.LocationName
                                </h4>
                            </div>
                        

                        <div class="card-body bg-white p-4 flex-grow-1 d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-light text-muted border px-3 py-2 fs-6 rounded-pill">
                                    ID: @location.LocationId
                                </span>
                            </div>

                            <p class="card-text fs-5 text-dark mb-4 flex-grow-1">
                                <i class="fa-solid fa-location-dot text-danger me-2"></i>@location.LocationAdress
                            </p>

                            <div class="mt-auto">
                                <a href="@location.LocationMapsPath" target="_blank" class="btn btn-outline-dark w-100 fw-bold rounded-pill">
                                    <i class="fa-solid fa-map me-2 text-success"></i>Відкрити на карті
                                </a>
                            </div>
                        </div>
						</a>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="card-footer bg-light border-0 d-flex justify-content-between px-4 pb-4 pt-3 gap-3" style="border-radius: 0 0 15px 15px;">
                                <a asp-controller="Location" asp-action="Edit" asp-route-id="@location.LocationId"
                                   class="btn btn-outline-primary fw-bold flex-grow-1" style="border-radius: 10px;">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                </a>
                                <a asp-controller="Location" asp-action="Delete" asp-route-id="@location.LocationId"
                                   class="btn btn-outline-danger fw-bold flex-grow-1" style="border-radius: 10px;"
                                   onclick="return confirm('Ви впевнені що хочете видалити цю локацію?');">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(111, 66, 193, 0.15) !important;
    }
</style>