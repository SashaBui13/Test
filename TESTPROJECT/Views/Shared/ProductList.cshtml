@model TESTPROJECT.Models.ViewModels.ProductViewModel

<div class="row g-4">

    <div class="input-group mb-3">
        <form asp-action="FindProduct" asp-controller="Home" method="post" >
            <input type="text" name="request" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="button-addon2">

            <button typeof="submit" class="btn btn-outline-secondary" type="submit" id="button-addon2">Done</button>
        </form>
    </div>
    @if (Model?.Products != null)
    {
        @foreach (var product in Model.Products.Take(9))
        {
            @if (product.IsDeleted == false)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 item-card shadow-sm d-flex flex-column">

                        <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark flex-grow-1 d-flex flex-column">
                            <div class="card-header-main text-white">
                                <h5 class="card-title mb-0 fw-bold fs-4">@product.Name</h5>
                                <h3>@product.Category?.Name</h3>
                            </div>

                            <div class="card-body p-0 text-center bg-light">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid" style="height: 200px; object-fit: contain; padding: 10px;" />
                                }
                                else
                                {
                                    <div style="height: 200px; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
                                        <i class="fa-solid fa-image text-muted" style="font-size: 4rem;"></i>
                                    </div>
                                }
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <div class="mb-3">
                                    <span class="badge bg-light text-primary border px-3 py-2 fs-6">
                                        @Model.Categories.FirstOrDefault(c => c.Id == product.CategoryId)?.Name
                                    </span>
                                </div>

                                <div class="my-2">
                                    <span class="price-box">@product.Price ₴</span>
                                </div>

                                <p class="card-text text-muted mt-3 mb-0 flex-grow-1">
                                    @product.Description
                                </p>
                            </div>
                        </a>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="card-footer bg-white border-0 d-flex justify-content-between gap-3 px-4 pb-4 mt-auto">
                                <a asp-controller="Home" asp-action="Edit" asp-route-id="@product.Id"
                                class="btn btn-outline-primary btn-custom flex-grow-1">
                                    Edit
                                </a>
                                <a asp-controller="Home" asp-action="Delete" asp-route-id="@product.Id"
                                class="btn btn-outline-danger btn-custom flex-grow-1"
                                onclick="return confirm('Видалити цей товар?');">
                                    Delete
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="card-footer bg-white border-0 px-4 pb-4 mt-auto">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@product.Id" class="btn text-white w-100 btn-custom d-block text-center text-decoration-none" style="background-color: var(--main-purple);">
                                    <i class="fa-solid fa-basket-shopping me-2"></i> В кошик
                                </a>
                            </div>
                        }

                    </div>
                </div>
            }
        }
        <div class="d-flex justify-content-center flex-wrap gap-3 mt-5 mb-5">
            @for (var Page = 0; Page <= (int)Math.Ceiling((double)Model.Products.Count() / 9); Page++)
            {
                <a asp-controller="Home" asp-action="Index" asp-route-Page="@Page" class="btn-show-more">
                    <i class="fa-solid fa-rotate-right me-2 icon-spin"></i>@(Page+1)
                </a>
                
            }
        </div>
        

        <style>
            .btn-show-more {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #6f42c1, #8b5cf6);
                color: white !important;
                text-decoration: none;
                border-radius: 50px;
                padding: 14px 45px;
                font-size: 1.1rem;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 1px;
                box-shadow: 0 6px 15px rgba(111, 66, 193, 0.3);
                transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }

                .btn-show-more:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 12px 25px rgba(111, 66, 193, 0.5);
                }

                .btn-show-more .icon-spin {
                    transition: transform 0.5s ease;
                }

                .btn-show-more:hover .icon-spin {
                    transform: rotate(180deg);
                }
        </style>
    }
</div>